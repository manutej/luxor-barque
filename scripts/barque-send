#!/usr/bin/env bash
#
# BARQUE Email Wrapper - Simplified one-line email delivery
# Usage: barque-send <file.md> [recipient@email.com]
#
# Features:
# - Smart defaults from user config
# - Single command execution
# - Graceful error handling
# - Progress feedback
# - Alias-friendly design

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
BARQUE_CONFIG="${HOME}/.config/barque/config.yaml"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BARQUE_ROOT="$(dirname "$SCRIPT_DIR")"

# Helper functions
log_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

log_success() {
    echo -e "${GREEN}✓${NC} $1"
}

log_error() {
    echo -e "${RED}✗${NC} $1" >&2
}

log_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Check dependencies
check_dependencies() {
    local missing=0

    # Check for barque in common locations
    if ! command -v barque &> /dev/null; then
        # Try to activate virtual environment if it exists
        if [ -f "$BARQUE_ROOT/venv/bin/activate" ]; then
            source "$BARQUE_ROOT/venv/bin/activate"
        elif [ -f "$BARQUE_ROOT/../venv/bin/activate" ]; then
            source "$BARQUE_ROOT/../venv/bin/activate"
        else
            log_error "barque CLI not found. Install with: pip install -e ."
            missing=1
        fi
    fi

    if ! command -v pop &> /dev/null; then
        log_error "Charm Pop not found. Install with: brew install pop"
        missing=1
    fi

    if [ $missing -eq 1 ]; then
        exit 1
    fi
}

# Load default recipient from config
get_default_recipient() {
    if [ -f "$BARQUE_CONFIG" ]; then
        # Try to extract default_to from config
        grep "default_to:" "$BARQUE_CONFIG" 2>/dev/null | awk '{print $2}' | tr -d '"' || echo ""
    fi
}

# Show usage
show_usage() {
    cat << EOF
${BLUE}BARQUE Email Wrapper${NC} - Simplified PDF generation and delivery

${GREEN}Usage:${NC}
  barque-send <file.md> [recipient@email.com]
  barque-send <file.md> --to email1@example.com --to email2@example.com

${GREEN}Examples:${NC}
  # Send to default recipient (from config)
  barque-send report.md

  # Send to specific recipient
  barque-send report.md boss@company.com

  # Send to multiple recipients
  barque-send report.md --to ceo@company.com --to cfo@company.com

  # Custom theme and subject
  barque-send report.md user@example.com --theme light --subject "Q4 Report"

${GREEN}Environment Variables:${NC}
  BARQUE_DEFAULT_TO     Default recipient email
  BARQUE_THEME          Default theme (light/dark/both)
  RESEND_API_KEY        Resend API key for email delivery

${GREEN}Configuration:${NC}
  Config file: ${BARQUE_CONFIG}

  To set default recipient:
    barque user-config set email.default_to your@email.com

${GREEN}Options:${NC}
  --theme <light|dark|both>    PDF theme (default: both)
  --subject <text>              Custom email subject
  --quiet                       Minimal output
  --help                        Show this help message

EOF
}

# Parse arguments
parse_args() {
    if [ $# -eq 0 ] || [ "$1" == "--help" ] || [ "$1" == "-h" ]; then
        show_usage
        exit 0
    fi

    INPUT_FILE="$1"
    shift

    # Check if file exists
    if [ ! -f "$INPUT_FILE" ]; then
        log_error "File not found: $INPUT_FILE"
        exit 1
    fi

    # Parse recipient and options
    RECIPIENTS=()
    THEME="${BARQUE_THEME:-both}"
    SUBJECT=""
    QUIET=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --to)
                RECIPIENTS+=("$2")
                shift 2
                ;;
            --theme)
                THEME="$2"
                shift 2
                ;;
            --subject)
                SUBJECT="$2"
                shift 2
                ;;
            --quiet)
                QUIET=1
                shift
                ;;
            *)
                # Assume it's a recipient email
                RECIPIENTS+=("$1")
                shift
                ;;
        esac
    done

    # If no recipients specified, try default
    if [ ${#RECIPIENTS[@]} -eq 0 ]; then
        DEFAULT_RECIPIENT="${BARQUE_DEFAULT_TO:-$(get_default_recipient)}"
        if [ -n "$DEFAULT_RECIPIENT" ]; then
            RECIPIENTS=("$DEFAULT_RECIPIENT")
            log_info "Using default recipient: $DEFAULT_RECIPIENT"
        else
            log_error "No recipient specified and no default configured"
            echo ""
            echo "Either:"
            echo "  1. Provide recipient: barque-send $INPUT_FILE user@example.com"
            echo "  2. Set default: barque user-config set email.default_to user@example.com"
            echo "  3. Set env var: export BARQUE_DEFAULT_TO=user@example.com"
            exit 1
        fi
    fi
}

# Main execution
main() {
    check_dependencies
    parse_args "$@"

    local filename=$(basename "$INPUT_FILE")

    [ $QUIET -eq 0 ] && log_info "Processing: $filename"
    [ $QUIET -eq 0 ] && log_info "Theme: $THEME"
    [ $QUIET -eq 0 ] && log_info "Recipients: ${RECIPIENTS[*]}"

    # Build barque command
    local cmd=("barque" "send" "$INPUT_FILE" "--theme" "$THEME")

    # Add recipients
    for recipient in "${RECIPIENTS[@]}"; do
        cmd+=("--to" "$recipient")
    done

    # Add subject if specified
    if [ -n "$SUBJECT" ]; then
        cmd+=("--subject" "$SUBJECT")
    fi

    # Execute
    echo ""
    if [ $QUIET -eq 0 ]; then
        "${cmd[@]}"
    else
        "${cmd[@]}" 2>&1 | grep -E "(✓|✗|Error)" || true
    fi

    local exit_code=$?

    if [ $exit_code -eq 0 ]; then
        echo ""
        log_success "Email sent successfully to ${RECIPIENTS[*]}"
        return 0
    else
        echo ""
        log_error "Email delivery failed (exit code: $exit_code)"
        return $exit_code
    fi
}

# Run main function
main "$@"
